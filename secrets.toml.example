# Iris secrets — credentials only. Copy to $IRIS_HOME/secrets.toml, chmod 600,
# and NEVER commit it (secrets.toml is gitignored):
#
#   cp secrets.toml.example ~/.local/share/iris/secrets.toml
#   chmod 600 ~/.local/share/iris/secrets.toml
#
# Loaded by iris.settings.get_secret — env or this file, never config.toml.
# An IRIS_* environment variable still overrides the matching value here.

[email]
# Gmail: an App Password (Google Account -> Security -> 2-Step Verification ->
# App passwords), NOT your normal password. Pairs with [email] in config.toml
# (imap_host/user/...). Verify the whole lane with:  iris-email-check
password = "your-app-password-here"   # -> IRIS_EMAIL_PASSWORD
