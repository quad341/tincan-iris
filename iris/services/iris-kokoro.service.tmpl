[Unit]
Description=Iris Kokoro TTS server
After=network-online.target

[Service]
Type=simple
WorkingDirectory={REPO_PATH}
ExecStart={PYTHON_KOKORO} {REPO_PATH}/iris/_kokoro_server.py \
    --model {REPO_PATH}/models/kokoro/kokoro-v1.0.onnx \
    --voices {REPO_PATH}/models/kokoro/voices-v1.0.bin
Restart=on-failure
RestartSec=5

# Network-isolate the engine — Kokoro runs fully offline.
IPAddressDeny=any
IPAddressAllow=localhost

StandardOutput=journal
StandardError=journal
SyslogIdentifier=iris-kokoro

[Install]
WantedBy=default.target
